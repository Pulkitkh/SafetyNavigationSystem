{
  "name": "SafeNav — Safety Navigation",
  "short_name": "SafeNav",
  "description": "Safest walking routes, live journey sharing, ride monitoring and SOS.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f8fafc",
  "theme_color": "#1d4ed8",
  "categories": ["navigation", "travel", "lifestyle"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Emergency help", "url": "/help", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Current journey", "url": "/journey", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
