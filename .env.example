# ---------------------------------------------------------------------------
# SafeNav configuration. Copy to .env.local and fill in what you need.
# Everything except APP_URL works with the defaults below.
# ---------------------------------------------------------------------------

# Public URL of the deployed app. Used to build live-tracking links in SOS messages.
APP_URL=http://localhost:3000

# Database (Postgres). In production use a hosted Postgres such as Supabase, so
# accounts survive restarts. On Supabase use the pooler URL (Connect → Session pooler);
# several URLs can be given, separated by spaces, and the first that connects wins.
# Without a postgres:// URL the app runs Postgres in-process (PGlite) in a local folder.
DATABASE_URL=file:./data/pg

# Contact e-mail sent in the User-Agent to OpenStreetMap services, as their
# usage policies require. Use a real address you read.
OSM_CONTACT_EMAIL=

# Timezone used to evaluate opening hours and night-time rules.
APP_TIMEZONE=Asia/Kolkata

# Open data services (defaults are the public community servers; self-host for scale).
# Each routing/Overpass variable takes a comma-separated list, tried in order when one
# is down or rate-limited. Leave empty to use the built-in mirror lists.
OSRM_FOOT_URL=https://routing.openstreetmap.de/routed-foot
OSRM_CAR_URL=https://routing.openstreetmap.de/routed-car,https://router.project-osrm.org
OVERPASS_URL=https://overpass.openstreetmap.fr/api/interpreter,https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter,https://overpass.kumi.systems/api/interpreter
# Fallback router and step-free (wheelchair) routing. Set to "off" to disable.
VALHALLA_URL=https://valhalla1.openstreetmap.de
PHOTON_URL=https://photon.komoot.io
NOMINATIM_URL=https://nominatim.openstreetmap.org
OPEN_METEO_URL=https://api.open-meteo.com

# Optional: Ola Maps place search (free tier, needs an API key from
# https://maps.olakrutrim.com). Adds Indian shops, buildings and addresses that
# OpenStreetMap lacks. A per-instance daily cap protects the free quota.
OLA_MAPS_API_KEY=
OLA_MAPS_DAILY_LIMIT=3000

# Map style (MapLibre style JSON). OpenFreeMap needs no key.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# ---------------------------------------------------------------------------
# Automatic SOS alerts to trusted contacts (free). Contacts open their invite
# link once; from then on every SOS reaches them with no action on your phone.
# Web Push: generate keys with  npx web-push generate-vapid-keys
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Server watchdog (docs/BACKGROUND_ALERTS.md): alerts contacts when a phone goes
# quiet, a journey is overdue or a safety timer runs out with the phone off.
# CRON_SECRET protects POST /api/cron/watchdog, which an outside scheduler calls
# every minute (it also keeps a free Render server awake). Any long random string.
CRON_SECRET=
# Optional: key for the share links the server makes itself. Defaults to one
# derived from VAPID_PRIVATE_KEY; changing it breaks links already sent.
SHARE_TOKEN_SECRET=
# Telegram: create a bot with @BotFather and paste its token. The webhook is set automatically.
TELEGRAM_BOT_TOKEN=
# WhatsApp (Meta's WhatsApp Cloud API; Meta charges per message, about ₹0.12 in India).
# Setup, including the template to get approved: docs/WHATSAPP.md
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=safenav_alert
WHATSAPP_TEMPLATE_LANG=en
# Optional: lets contacts reply STOP. Set the webhook URL to <APP_URL>/api/whatsapp/webhook.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Ringing SOS alarms in the Android app (Firebase Cloud Messaging, free).
# Paste the whole JSON files; see docs/RINGING_ALERTS.md.
FIREBASE_ANDROID_CONFIG=
FIREBASE_SERVICE_ACCOUNT=

# ---------------------------------------------------------------------------
# Optional automatic SOS SMS. Leave empty to use the free one-tap SMS/WhatsApp flow.
# SMS_PROVIDER = twilio | msg91
# ---------------------------------------------------------------------------
SMS_PROVIDER=

# Twilio (https://www.twilio.com). For Indian numbers Twilio needs DLT registration.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# MSG91 (https://msg91.com) Flow API. Create a DLT-approved template with
# variables ##name## ##link## ##place## and put its id here.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ---------------------------------------------------------------------------
# Native Android/iOS app (Capacitor). The app shell loads this URL.
# ---------------------------------------------------------------------------
CAP_SERVER_URL=
